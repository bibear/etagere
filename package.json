{
  "name": "etagere",
  "version": "0.1.0",
  "private": true,
  "description": "A household book library that stays at home.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bibear/etagere.git"
  },
  "workspaces": [
    "packages/shared",
    "server",
    "app"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "server": "npm run dev -w etagere-server",
    "app": "npm run start -w @etagere/app",
    "web": "npm run web -w @etagere/app",
    "build:web": "npm run export:web -w @etagere/app && tsx server/src/pwa/build-cli.ts app/dist server/public",
    "release:docker": "node scripts/release-docker.js",
    "release:version": "node scripts/set-version.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
